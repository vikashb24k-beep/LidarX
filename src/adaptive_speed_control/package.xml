<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adaptive_speed_control</name>
  <version>1.0.0</version>
  <description>ROS 2 Adaptive Speed Controller and Autonomous Navigation in Cluttered Environments.</description>
  <maintainer email="endrigjinaj49@gmail.com">Endri Gjinaj</maintainer>
  <author email="vikash@iiitdwd.ac.in">Vikash</author>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_updater</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <exec_depend>twist_mux</exec_depend>
  <depend>adaptive_speed_interfaces</depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
