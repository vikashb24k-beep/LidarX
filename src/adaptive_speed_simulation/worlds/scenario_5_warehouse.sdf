<sdf version='1.10'>
  <world name='warehouse'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Overhead Warehouse Lighting -->
    <light name='sun' type='directional'>
      <pose>0 0 15 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.3</intensity>
      <direction>-0.2 0.2 -0.95</direction>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>
    <light name='bay_light_1' type='point'>
      <pose>-5.0 0 5.0 0 0 0</pose>
      <intensity>0.8</intensity>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.05</linear></attenuation>
    </light>
    <light name='bay_light_2' type='point'>
      <pose>5.0 0 5.0 0 0 0</pose>
      <intensity>0.8</intensity>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.05</linear></attenuation>
    </light>

    <!-- Concrete Floor (20m x 14m) -->
    <model name='warehouse_floor'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>22 16</size></plane></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>22 16</size></plane></geometry>
          <material>
            <ambient>0.45 0.46 0.47 1</ambient>
            <diffuse>0.48 0.49 0.50 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Exterior Warehouse Walls (20m x 14m, H: 3m) -->
    <model name='wall_north'>
      <pose>0.0 7.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>20.4 0.25 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>20.4 0.25 3.0</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.6 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_south'>
      <pose>0.0 -7.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>20.4 0.25 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>20.4 0.25 3.0</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.6 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_east'>
      <pose>10.0 0.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.25 14.0 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.25 14.0 3.0</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.6 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_west'>
      <pose>-10.0 0.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.25 14.0 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.25 14.0 3.0</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.6 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Decorative Safety Lines (NO collision) -->
    <model name='safety_line_loading'>
      <pose>-6.0 0.0 0.002 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <visual name='vis'>
          <geometry><box><size>0.15 13.0 0.002</size></box></geometry>
          <material><ambient>0.95 0.8 0.05 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='safety_line_aisle1'>
      <pose>0.5 2.95 0.002 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <visual name='vis'>
          <geometry><box><size>9.0 0.10 0.002</size></box></geometry>
          <material><ambient>0.95 0.8 0.05 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='safety_line_aisle2'>
      <pose>0.5 1.55 0.002 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <visual name='vis'>
          <geometry><box><size>9.0 0.10 0.002</size></box></geometry>
          <material><ambient>0.95 0.8 0.05 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Aisle signs (NO collision) -->
    <model name='aisle_sign_1'>
      <pose>-3.8 2.25 2.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <visual name='vis'>
          <geometry><box><size>0.05 0.6 0.3</size></box></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- TALL SHELF RACKS (Orange Uprights, Brown Cargo Boxes)          -->
    <!-- Rows at y = 3.6, y = 0.9, y = -1.8, y = -4.5                   -->
    <!-- Aisle 1 (y = 2.25): between row 1 & row 2 (~1.7m wide)        -->
    <!-- ============================================================= -->

    <!-- SHELF ROW 1 (y = 3.6m, length: 8m, x from -3.5 to 4.5) -->
    <model name='shelf_row_1'>
      <pose>0.5 3.6 1.3 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>8.0 1.0 2.6</size></box></geometry></collision>
        <visual name='frame_main'>
          <geometry><box><size>8.0 0.95 2.58</size></box></geometry>
          <material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material>
        </visual>
        <visual name='cargo_1'>
          <pose>-2.5 0.0 0.2 0 0 0</pose>
          <geometry><box><size>1.6 0.85 0.7</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <visual name='cargo_2'>
          <pose>0.5 0.0 0.2 0 0 0</pose>
          <geometry><box><size>1.8 0.85 0.75</size></box></geometry>
          <material><ambient>0.5 0.32 0.14 1</ambient><diffuse>0.55 0.36 0.18 1</diffuse></material>
        </visual>
        <visual name='cargo_3'>
          <pose>2.8 0.0 0.2 0 0 0</pose>
          <geometry><box><size>1.5 0.85 0.7</size></box></geometry>
          <material><ambient>0.6 0.42 0.22 1</ambient><diffuse>0.65 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SHELF ROW 2 (y = 0.9m, length: 8m, x from -3.5 to 4.5) -->
    <model name='shelf_row_2'>
      <pose>0.5 0.9 1.3 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>8.0 1.0 2.6</size></box></geometry></collision>
        <visual name='frame_main'>
          <geometry><box><size>8.0 0.95 2.58</size></box></geometry>
          <material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material>
        </visual>
        <visual name='cargo_1'>
          <pose>-2.0 0.0 0.2 0 0 0</pose>
          <geometry><box><size>1.7 0.85 0.7</size></box></geometry>
          <material><ambient>0.58 0.38 0.18 1</ambient><diffuse>0.62 0.42 0.22 1</diffuse></material>
        </visual>
        <visual name='cargo_2'>
          <pose>1.0 0.0 0.2 0 0 0</pose>
          <geometry><box><size>1.6 0.85 0.75</size></box></geometry>
          <material><ambient>0.5 0.32 0.14 1</ambient><diffuse>0.55 0.36 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SHELF ROW 3 (y = -1.8m, length: 8m, x from -3.5 to 4.5) -->
    <model name='shelf_row_3'>
      <pose>0.5 -1.8 1.3 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>8.0 1.0 2.6</size></box></geometry></collision>
        <visual name='frame_main'>
          <geometry><box><size>8.0 0.95 2.58</size></box></geometry>
          <material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material>
        </visual>
        <visual name='cargo_1'>
          <pose>-1.5 0.0 0.2 0 0 0</pose>
          <geometry><box><size>2.0 0.85 0.7</size></box></geometry>
          <material><ambient>0.52 0.34 0.16 1</ambient><diffuse>0.58 0.38 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SHELF ROW 4 (y = -4.5m, length: 8m, x from -3.5 to 4.5) -->
    <model name='shelf_row_4'>
      <pose>0.5 -4.5 1.3 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>8.0 1.0 2.6</size></box></geometry></collision>
        <visual name='frame_main'>
          <geometry><box><size>8.0 0.95 2.58</size></box></geometry>
          <material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material>
        </visual>
        <visual name='cargo_1'>
          <pose>0.0 0.0 0.2 0 0 0</pose>
          <geometry><box><size>2.5 0.85 0.75</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- SCATTERED CLUTTER (Pallets, Boxes, Forklift, Cones)           -->
    <!-- Placed safely on boundaries so aisle pathways remain open     -->
    <!-- ============================================================= -->

    <!-- Pallets Stack in Loading Area -->
    <model name='pallet_stack_1'>
      <pose>-7.0 -3.2 0.25 0 0 0.2</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>1.2 1.0 0.5</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>1.2 1.0 0.5</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pallets Stack 2 in North loading area -->
    <model name='pallet_stack_2'>
      <pose>-7.0 3.8 0.3 0 0 -0.1</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>1.2 1.0 0.6</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>1.2 1.0 0.6</size></box></geometry>
          <material><ambient>0.58 0.42 0.22 1</ambient><diffuse>0.62 0.48 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Stacked Cardboard Boxes in East Clutter Zone -->
    <model name='cardboard_stack_1'>
      <pose>6.8 -2.2 0.45 0 0 0.15</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.9 0.9 0.9</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.9 0.9 0.9</size></box></geometry>
          <material><ambient>0.7 0.52 0.3 1</ambient><diffuse>0.75 0.58 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Traffic Safety Cones on edges -->
    <model name='traffic_cone_1'>
      <pose>-4.2 1.2 0.3 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>1.0 0.35 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='traffic_cone_2'>
      <pose>6.2 1.4 0.3 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>1.0 0.35 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Yellow Wet Floor Sign -->
    <model name='wet_floor_sign'>
      <pose>-3.2 2.8 0.3 0 0 0.3</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.25 0.20 0.6</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.25 0.20 0.6</size></box></geometry>
          <material><ambient>0.95 0.85 0.05 1</ambient><diffuse>1.0 0.9 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parked Forklift (Made of boxes) at (x = 6.4, y = 3.6) -->
    <model name='parked_forklift'>
      <pose>6.5 3.6 0.0 0 0 3.1415</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col_body'><pose>0 0 0.5 0 0 0</pose><geometry><box><size>1.6 1.0 1.0</size></box></geometry></collision>
        <visual name='vis_body'><pose>0 0 0.5 0 0 0</pose><geometry><box><size>1.6 1.0 1.0</size></box></geometry>
          <material><ambient>0.95 0.75 0.05 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse></material>
        </visual>
        <visual name='vis_mast'><pose>0.85 0 1.0 0 0 0</pose><geometry><box><size>0.15 0.6 1.8</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- WORKERS (Cylinders: Diameter 0.5m, Height 1.7m)                -->
    <!-- Static & Dynamic Obstacles                                     -->
    <!-- ============================================================= -->

    <!-- Static Worker 1 (Loading Dock Overseer - Blue) -->
    <model name='worker_static_1'>
      <pose>-8.0 2.5 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.15 0.35 0.8 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static Worker 2 (Near Shelf Row 1 - Orange Hi-Vis) -->
    <model name='worker_static_2'>
      <pose>0.0 5.0 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.95 0.4 0.05 1</ambient><diffuse>1.0 0.45 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static Worker 3 (Near Shelf Row 3 - Yellow Hi-Vis) -->
    <model name='worker_static_3'>
      <pose>-1.5 -3.0 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.1 1</ambient><diffuse>0.9 0.9 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static Worker 4 (Forklift Operator) -->
    <model name='worker_static_4'>
      <pose>5.2 4.8 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.2 0.25 0.4 1</ambient><diffuse>0.25 0.3 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static Worker 5 (Near Office) -->
    <model name='worker_static_5'>
      <pose>7.5 -2.5 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.25 1</ambient><diffuse>0.15 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DYNAMIC WORKER 1: Patrolling Cross Aisle (x = -5.0, y from -1.5 to 1.0) -->
    <model name='dynamic_worker_1'>
      <pose>-5.0 -1.0 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.9 0.15 0.15 1</ambient><diffuse>0.95 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DYNAMIC WORKER 2: Patrolling Aisle 1 (y = 2.25, x from 1.5 to 4.0) -->
    <model name='dynamic_worker_2'>
      <pose>2.5 2.25 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.85 0.45 0.0 1</ambient><diffuse>0.9 0.5 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DYNAMIC WORKER 3: Patrolling Loading Dock North (y = 4.5, x from -6.5 to -4.5) -->
    <model name='dynamic_worker_3'>
      <pose>-5.5 4.5 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.7 1</ambient><diffuse>0.15 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
