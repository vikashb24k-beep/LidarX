          </material>
        </visual>
      </link>
    </model>

    <!-- DESTINATION Plate (Bright Gold) at x = 9.0, y = 0.0 -->
    <model name='floor_goal_marker'>
      <pose>9.0 0.0 0.005 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <visual name='visual'>
