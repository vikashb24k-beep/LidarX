          <material>
            <ambient>0.8 0.65 0.0 1</ambient>
            <diffuse>0.95 0.8 0.0 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- ZONE 2: MODERATE TRAFFIC OBSTACLES (Staggered Side Pillars)       -->
    <!-- ================================================================= -->
    <model name='zone2_pillar_1'>
      <pose>-3.2 0.95 0.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
