    </model>

    <!-- ================================================================= -->
    <!-- ZONE 3: CLUTTERED CORRIDOR (Multiple Bilateral Obstacles)         -->
    <!-- Central corridor clearance is 1.04m, safely enclosing 0.4m robot  -->
    <!-- ================================================================= -->
    <model name='clutter_box_L1'>
      <pose>1.0 0.75 0.4 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.35 0.35 0.8</size></box></geometry>
