    <!-- ================================================================= -->
    <!-- ZONE 4: CRITICAL PROXIMITY BARRIER (Direct Path Obstacle)         -->
    <!-- Positioned at x = 6.6, y = 0.0; blocks path until cleared         -->
    <!-- ================================================================= -->
    <model name='zone4_barrier'>
      <pose>6.6 0.0 0.5 0 0 0</pose>
