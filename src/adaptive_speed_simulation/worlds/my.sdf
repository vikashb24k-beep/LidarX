    <model name='zone2_pillar_3'>
      <pose>-0.4 0.90 0.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><cylinder><radius>0.20</radius><length>1.0</length></cylinder></geometry>
