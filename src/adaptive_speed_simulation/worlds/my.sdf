    <model name='zone2_pillar_2'>
      <pose>-1.8 -0.95 0.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry>
