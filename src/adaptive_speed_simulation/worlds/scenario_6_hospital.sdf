<sdf version='1.10'>
  <world name='hospital'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.65 0.65 0.68 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Hospital Interior Lighting -->
    <light name='sun' type='directional'>
      <pose>0 0 15 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.3</intensity>
      <direction>-0.1 0.2 -0.98</direction>
      <diffuse>0.92 0.94 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>
    <light name='lobby_light_1' type='point'>
      <pose>-3.0 0 4.5 0 0 0</pose>
      <intensity>0.85</intensity>
      <diffuse>0.88 0.92 0.95 1</diffuse>
      <attenuation><range>18</range><constant>0.5</constant><linear>0.05</linear></attenuation>
    </light>
    <light name='corridor_light' type='point'>
      <pose>6.0 3.5 4.5 0 0 0</pose>
      <intensity>0.8</intensity>
      <diffuse>0.88 0.92 0.95 1</diffuse>
      <attenuation><range>15</range><constant>0.5</constant><linear>0.05</linear></attenuation>
    </light>

    <!-- Clean Hospital Floor (18m x 12m) -->
    <model name='hospital_floor'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>20 14</size></plane></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>20 14</size></plane></geometry>
          <material>
            <ambient>0.78 0.80 0.82 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Exterior Hospital Walls (18m x 12m, H: 3.0m) -->
    <model name='wall_north'>
      <pose>0.0 6.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>18.4 0.25 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>18.4 0.25 3.0</size></box></geometry>
          <material><ambient>0.85 0.88 0.90 1</ambient><diffuse>0.90 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_south'>
      <pose>0.0 -6.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>18.4 0.25 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>18.4 0.25 3.0</size></box></geometry>
          <material><ambient>0.85 0.88 0.90 1</ambient><diffuse>0.90 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_west'>
      <pose>-9.0 0.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.25 12.0 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.25 12.0 3.0</size></box></geometry>
          <material><ambient>0.85 0.88 0.90 1</ambient><diffuse>0.90 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_east'>
      <pose>9.0 0.0 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.25 12.0 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.25 12.0 3.0</size></box></geometry>
          <material><ambient>0.85 0.88 0.90 1</ambient><diffuse>0.90 0.92 0.94 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Interior Partition Wall & Doorway into East Corridor -->
    <!-- Partition from y = -6.0 to y = 1.5, leaving doorway from y = 1.5 to 5.5 -->
    <model name='corridor_partition_south'>
      <pose>4.0 -2.25 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.25 7.5 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.25 7.5 3.0</size></box></geometry>
          <material><ambient>0.82 0.85 0.88 1</ambient><diffuse>0.86 0.89 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Corridor Inner Divider separating corridor from storage/rooms -->
    <model name='corridor_partition_inner'>
      <pose>6.5 1.8 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>5.0 0.25 3.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>5.0 0.25 3.0</size></box></geometry>
          <material><ambient>0.82 0.85 0.88 1</ambient><diffuse>0.86 0.89 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Decorative Hospital Guidance Line on Floor (NO collision) -->
    <model name='floor_nav_stripe'>
      <pose>-1.0 0.0 0.002 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <visual name='vis'>
          <geometry><box><size>12.0 0.15 0.002</size></box></geometry>
          <material><ambient>0.1 0.6 0.8 1</ambient><diffuse>0.1 0.65 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- RECEPTION DESK (L-shaped, wood/laminate finish)                -->
    <!-- Position: x ~ 0.0, y ~ 3.0                                     -->
    <!-- ============================================================= -->
    <model name='reception_desk_main'>
      <pose>0.2 3.2 0.55 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.8 3.2 1.1</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>0.8 3.2 1.1</size></box></geometry>
          <material><ambient>0.75 0.68 0.58 1</ambient><diffuse>0.82 0.75 0.65 1</diffuse></material>
        </visual>
        <!-- Desktop Countertop Trim -->
        <visual name='vis_top'>
          <pose>0 0 0.55 0 0 0</pose>
          <geometry><box><size>0.9 3.3 0.06</size></box></geometry>
          <material><ambient>0.9 0.92 0.95 1</ambient><diffuse>0.95 0.96 0.98 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='reception_desk_side'>
      <pose>-0.9 4.4 0.55 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>1.6 0.8 1.1</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>1.6 0.8 1.1</size></box></geometry>
          <material><ambient>0.75 0.68 0.58 1</ambient><diffuse>0.82 0.75 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- WAITING AREA CHAIRS (3 Rows, Blue upholstery)                  -->
    <!-- Rows at y = -2.0, y = -3.2, y = -4.4                           -->
    <!-- ============================================================= -->
    <model name='waiting_chairs_row1'>
      <pose>-2.2 -2.0 0.4 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>2.6 0.65 0.8</size></box></geometry></collision>
        <visual name='seat_1'><pose>-0.8 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name='seat_2'><pose>0.0 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name='seat_3'><pose>0.8 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='waiting_chairs_row2'>
      <pose>-2.2 -3.2 0.4 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>2.6 0.65 0.8</size></box></geometry></collision>
        <visual name='seat_1'><pose>-0.8 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name='seat_2'><pose>0.0 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name='seat_3'><pose>0.8 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='waiting_chairs_row3'>
      <pose>-2.2 -4.4 0.4 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><box><size>2.6 0.65 0.8</size></box></geometry></collision>
        <visual name='seat_1'><pose>-0.8 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name='seat_2'><pose>0.0 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name='seat_3'><pose>0.8 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- ARCHITECTURAL PILLARS & POTTED PLANTS                          -->
    <!-- ============================================================= -->
    <!-- Central Lobby Architectural Pillar -->
    <model name='lobby_pillar_central'>
      <pose>1.8 -0.8 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.85 0.88 0.90 1</ambient><diffuse>0.88 0.90 0.93 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Entrance Pillar -->
    <model name='lobby_pillar_west'>
      <pose>-5.0 2.8 1.5 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.85 0.88 0.90 1</ambient><diffuse>0.88 0.90 0.93 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Potted Plant 1 (near entrance) -->
    <model name='potted_plant_1'>
      <pose>-7.2 4.2 0.0 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col_pot'><pose>0 0 0.35 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name='vis_pot'><pose>0 0 0.35 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.92 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <visual name='vis_plant'><pose>0 0 0.95 0 0 0</pose><geometry><sphere><radius>0.42</radius></sphere></geometry>
          <material><ambient>0.1 0.5 0.15 1</ambient><diffuse>0.15 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Potted Plant 2 (near waiting area corner) -->
    <model name='potted_plant_2'>
      <pose>0.8 -4.8 0.0 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col_pot'><pose>0 0 0.35 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name='vis_pot'><pose>0 0 0.35 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.92 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <visual name='vis_plant'><pose>0 0 0.95 0 0 0</pose><geometry><sphere><radius>0.42</radius></sphere></geometry>
          <material><ambient>0.1 0.5 0.15 1</ambient><diffuse>0.15 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wheelchair Shape (near waiting area x = -5.0, y = -3.5) -->
    <model name='hospital_wheelchair'>
      <pose>-5.0 -3.5 0.0 0 0 0.5</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><pose>0 0 0.45 0 0 0</pose><geometry><box><size>0.75 0.65 0.9</size></box></geometry></collision>
        <!-- Seat and back -->
        <visual name='seat'><pose>0 0 0.4 0 0 0</pose><geometry><box><size>0.5 0.48 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name='back'><pose>-0.22 0 0.65 0 0 0</pose><geometry><box><size>0.08 0.48 0.45</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Wheels -->
        <visual name='left_wheel'><pose>0 0.28 0.32 1.5707 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.75 0.75 0.8 1</diffuse></material>
        </visual>
        <visual name='right_wheel'><pose>0 -0.28 0.32 1.5707 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.75 0.75 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- PEOPLE: STAFF (Green) & PATIENTS / VISITORS                    -->
    <!-- Static & Dynamic Obstacles (Cylinders ~0.5m x 1.7m)            -->
    <!-- ============================================================= -->

    <!-- Hospital Staff 1: Nurse behind desk (Green uniform) -->
    <model name='staff_nurse_1'>
      <pose>0.8 2.5 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.1 0.65 0.35 1</ambient><diffuse>0.15 0.72 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Hospital Staff 2: Receptionist behind desk (Green uniform) -->
    <model name='staff_nurse_2'>
      <pose>0.8 3.8 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.1 0.65 0.35 1</ambient><diffuse>0.15 0.72 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visitor Standing at Reception Desk (Dark Blue coat) -->
    <model name='visitor_desk'>
      <pose>-0.4 2.4 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.15 0.25 0.55 1</ambient><diffuse>0.2 0.3 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Sitting Visitor 1 in Waiting Area (Grey/Beige) -->
    <model name='waiting_visitor_1'>
      <pose>-1.4 -2.0 0.6 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.24</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.24</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.65 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Sitting Visitor 2 in Waiting Area (Maroon) -->
    <model name='waiting_visitor_2'>
      <pose>-2.2 -3.2 0.6 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.24</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.24</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.55 0.15 0.2 1</ambient><diffuse>0.65 0.2 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Standing Visitor near entrance bulletin (Purple) -->
    <model name='visitor_bulletin'>
      <pose>-6.8 2.5 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.45 0.2 0.5 1</ambient><diffuse>0.55 0.25 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DYNAMIC PERSON 1: Walking across lobby (x from -1.5 to 2.0 at y = 0.5) -->
    <model name='dynamic_person_1'>
      <pose>0.0 0.5 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.85 0.35 0.1 1</ambient><diffuse>0.92 0.42 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DYNAMIC PERSON 2: Walking near waiting area (y from -1.0 to 1.5 at x = -4.0) -->
    <model name='dynamic_person_2'>
      <pose>-4.0 0.0 0.85 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name='vis'><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.75 1</ambient><diffuse>0.15 0.78 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

